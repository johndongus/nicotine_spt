<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Nicotine.Server</AssemblyName>
    <RootNamespace>Nicotine.Server</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core" HintPath="$(SptServerDir)\SPTarkov.Server.Core.dll" Private="false" />
    <Reference Include="SPTarkov.DI" HintPath="$(SptServerDir)\SPTarkov.DI.dll" Private="false" />
    <Reference Include="SPTarkov.Common" HintPath="$(SptServerDir)\SPTarkov.Common.dll" Private="false" />
    <Reference Include="SemanticVersioning" HintPath="$(SptServerDir)\SemanticVersioning.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployNicotineServer" AfterTargets="Build" Condition="'$(DeployToSpt)' == 'true' And Exists('$(SptServerDir)\user\mods')">
    <PropertyGroup>
      <NicotineModDir>$(SptServerDir)\user\mods\Nicotine</NicotineModDir>
    </PropertyGroup>
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb" DestinationFolder="$(NicotineModDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Nicotine server mod deployed to $(NicotineModDir)" />
  </Target>

</Project>
